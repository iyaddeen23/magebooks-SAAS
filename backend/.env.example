# Django Runtime Settings
DJANGO_SECRET_KEY=<your-secret-key>
DJANGO_DEBUG=<true-or-false>
DJANGO_ALLOWED_HOSTS=<comma-separated-hosts>
DJANGO_CORS_ALLOWED_ORIGINS=<comma-separated-frontend-urls>

# Primary Database (PostgreSQL)
DATABASE_URL=postgres://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-r2-bucket-name>
R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com

# Redis & Celery (Asynchronous Task Queue)
REDIS_URL=redis://<redis-host>:<redis-port>/<redis-db-number>
